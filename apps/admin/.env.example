# Copy to `.env`. Do not commit real secrets.
#
# PostNord Track & Trace is proxied at /api/postnord/track (uses POSTNORD_API_KEY only).
# The Shipping Module (POSTNORD_SHIPPING_*) is not used by the admin app.

# -----------------------------------------------------------------------------
# PostNord — Track Shipment API
# -----------------------------------------------------------------------------
POSTNORD_API_KEY=

# Optional: sandbox
# POSTNORD_USE_TEST_API=true
# POSTNORD_API_HOST=api2.postnord.com
# POSTNORD_TRACK_SHIPMENT_VERSION=v2

# -----------------------------------------------------------------------------
# Database & Auth (admin studio)
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/turbodb
NEXTAUTH_URL=http://localhost:3001
AUTH_URL=http://localhost:3001

# -----------------------------------------------------------------------------
# Backend services
# -----------------------------------------------------------------------------
PRODUCT_SERVICE_URL=http://localhost:8000
NEXT_PUBLIC_PRODUCT_API_URL=http://localhost:8000
PAYMENT_SERVICE_URL=http://localhost:8002
INTERNAL_PRODUCT_API_SECRET=

# Storefront origin (e.g. “pay balance” links from order detail)
NEXT_PUBLIC_CLIENT_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Optional
# -----------------------------------------------------------------------------
# Comma-separated Auth.js user ids allowed to access the dashboard
# ADMIN_ALLOWLIST=

# Cron: POST /api/cron/sync-shipping-status
# CRON_SECRET=

# AI helpers (translate / suggest description)
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=

# NEXT_PUBLIC_R2_PUBLIC_URL=
# NEXT_PUBLIC_UPLOADS_BASE=http://localhost:3001
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=turbomeck
# R2_PUBLIC_URL=
