# Copy to `.env`. Do not commit real secrets.
#
# PostNord Track & Trace is proxied at /api/postnord/track.
# Admin “Boka frakt (EDI)” uses the same POSTNORD_API_KEY for Booking API POST /v3/edi.
# Destination countries for that button (ISO2, comma-separated). Default if unset: SE,NO,DK
# POSTNORD_EDI_DESTINATION_COUNTRIES=SE,NO,DK
# Same list for the admin UI (order page). Optional if you use the default.
# NEXT_PUBLIC_POSTNORD_EDI_DESTINATION_COUNTRIES=SE,NO,DK
# Label PDF: after booking, the admin downloads via GET /api/orders/:id/postnord-label-pdf
# (server calls POST …/rest/shipment/v3/edi/labels/pdf). Portal: https://developer.postnord.com/

# -----------------------------------------------------------------------------
# PostNord — sandbox / local testing
# -----------------------------------------------------------------------------
# Uncomment when using a sandbox apikey: Track + EDI use atapi2.postnord.com.
# POSTNORD_USE_TEST_API=true

POSTNORD_API_KEY=

# Production: leave POSTNORD_USE_TEST_API unset/false and use production apikey.
# Optional: custom REST hostname when not in sandbox (no https://)
# POSTNORD_API_HOST=api2.postnord.com

# POSTNORD_TRACK_SHIPMENT_VERSION=v2

# -----------------------------------------------------------------------------
# PostNord — Booking API EDI (order detail → “Boka frakt (EDI)”)
# Confirm basicServiceCode / party types with PostNord (kundintegration.se@postnord.com).
# @see https://portal.postnord.com/se/sv/resurser/integrationer/api/boknings-api/
# -----------------------------------------------------------------------------
POSTNORD_EDI_CUSTOMER_NUMBER=
POSTNORD_CONSIGNOR_COMPANY_NAME=Turbomeck
POSTNORD_CONSIGNOR_STREET=
POSTNORD_CONSIGNOR_POSTAL_CODE=
POSTNORD_CONSIGNOR_CITY=
POSTNORD_CONSIGNOR_COUNTRY=SE
# POSTNORD_CONSIGNOR_PHONE=
# POSTNORD_CONSIGNOR_EMAIL=

# Product on agreement (default 52 — replace with code from your avtal)
# POSTNORD_EDI_BASIC_SERVICE_CODE=52
# Extra services, comma-separated or JSON array e.g. ["A3"]
# POSTNORD_EDI_ADDITIONAL_SERVICE_CODES=

# Party id type for avsändare (swagger example 160)
# POSTNORD_EDI_PARTY_ID_TYPE=160
# Issuer on parties (swagger example Z11)
# POSTNORD_EDI_ISSUER_CODE=Z11
# Service point id type for deliveryParty (default 17 — verify with PostNord)
# POSTNORD_EDI_SERVICEPOINT_PARTY_ID_TYPE=17

# Mark EDI as test in PostNord (often use with POSTNORD_USE_TEST_API=true)
# POSTNORD_EDI_TEST=true

# Optional application block overrides
# POSTNORD_EDI_APPLICATION_ID=9999
# POSTNORD_EDI_APPLICATION_NAME=Turbomeck Admin
# POSTNORD_EDI_APPLICATION_VERSION=1.0
# POSTNORD_EDI_LANGUAGE=SV

# -----------------------------------------------------------------------------
# Database & Auth (admin studio)
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/turbodb
NEXTAUTH_URL=http://localhost:3001
AUTH_URL=http://localhost:3001

# -----------------------------------------------------------------------------
# Backend services
# -----------------------------------------------------------------------------
PRODUCT_SERVICE_URL=http://localhost:8000
NEXT_PUBLIC_PRODUCT_API_URL=http://localhost:8000
PAYMENT_SERVICE_URL=http://localhost:8002
INTERNAL_PRODUCT_API_SECRET=

# Storefront origin (e.g. “pay balance” links from order detail)
NEXT_PUBLIC_CLIENT_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Optional
# -----------------------------------------------------------------------------
# Comma-separated Auth.js user ids allowed to access the dashboard
# ADMIN_ALLOWLIST=

# Cron: POST /api/cron/sync-shipping-status
# CRON_SECRET=

# AI helpers (translate / suggest description)
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=

# NEXT_PUBLIC_R2_PUBLIC_URL=
# NEXT_PUBLIC_UPLOADS_BASE=http://localhost:3001
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=turbomeck
# R2_PUBLIC_URL=
