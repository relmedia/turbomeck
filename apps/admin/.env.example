# Copy to `.env`. Do not commit real secrets.
#
# PostNord Track & Trace is proxied at /api/postnord/track.
# Admin “Boka frakt” uses POSTNORD_API_KEY for Booking API + label PDF.
# Destination countries (ISO2, comma-separated). Default if unset: SE,NO,DK
# POSTNORD_EDI_DESTINATION_COUNTRIES=SE,NO,DK
# Same list in the admin UI (order page). Optional if you use the default.
# NEXT_PUBLIC_POSTNORD_EDI_DESTINATION_COUNTRIES=SE,NO,DK
# Label PDF: after booking, admin downloads via GET /api/orders/:id/postnord-label-pdf
# (server calls POST …/rest/shipment/v3/edi/labels/pdf).

# -----------------------------------------------------------------------------
# PostNord — sandbox / local testing
# -----------------------------------------------------------------------------
# Uncomment when using a sandbox apikey: Track + booking use atapi2.postnord.com.
# POSTNORD_USE_TEST_API=true

POSTNORD_API_KEY=

# -----------------------------------------------------------------------------
# PostNord — OAuth (IAM-secured endpoints only)
# -----------------------------------------------------------------------------
# As of 2026-05 the documented production token host gate.ess.postnord.com resolves to a
# DELETED AWS ELB (NXDOMAIN). pp-gate.ess.postnord.com is also gone. If your booking plan does
# not require IAM, leave POSTNORD_CLIENT_ID unset (or set POSTNORD_SKIP_OAUTH=true) — apikey alone is enough.
# If your plan needs IAM, contact api.support@postnord.com for the CURRENT token URL and put it in
# POSTNORD_OAUTH_TOKEN_URL below (overrides the dead default).
#
# POSTNORD_CLIENT_ID=
# POSTNORD_CLIENT_SECRET=
# POSTNORD_OAUTH_SCOPE=https://api.postnord.com/scopes/...
# POSTNORD_OAUTH_TOKEN_URL=https://<new-host>/<path>/token
#
# Behavior knobs:
# POSTNORD_SKIP_OAUTH=true            # don’t even attempt OAuth even if CLIENT_ID is set
# POSTNORD_OAUTH_REQUIRED=true        # if true, OAuth failure aborts booking (default: warn + continue without Bearer)

# Production: leave POSTNORD_USE_TEST_API unset/false and use production apikey.
# Optional: custom REST hostname when not in sandbox (no https://)
# POSTNORD_API_HOST=api2.postnord.com

# POSTNORD_TRACK_SHIPMENT_VERSION=v2

# -----------------------------------------------------------------------------
# PostNord — DNS bypass (only if Node fetch fails with ENOTFOUND while `dig` works)
# -----------------------------------------------------------------------------
# Node’s global fetch uses libc/getaddrinfo; this knob makes PostNord calls (only) go through
# dns.Resolver — direct UDP/TCP queries that honour the servers below. Other DNS in the app is untouched.
# POSTNORD_DNS_SERVERS=1.1.1.1,8.8.8.8
# Force the bypass without overriding the resolver list (uses system resolver via dns.Resolver):
# POSTNORD_DNS_BYPASS_GETADDRINFO=true
# Optional: POSTNORD_DNS_IPV4_FIRST=true (broken IPv6 routing to PostNord)
# Verify DNS from the server: dig gate.ess.postnord.com @1.1.1.1
# Or: node apps/admin/scripts/postnord-dns-check.mjs

# -----------------------------------------------------------------------------
# PostNord — Booking API (service point / ombud)
# OAuth + apikey; avsändarnummer och lageradress nedan är valfria om PostNord kopplat avsändaren till avtalet.
# @see https://portal.postnord.com/se/sv/resurser/integrationer/api/boknings-api/
# -----------------------------------------------------------------------------
# Optional explicit avsändarnummer om det krävs i er payload
# POSTNORD_EDI_CUSTOMER_NUMBER=

POSTNORD_CONSIGNOR_COMPANY_NAME=Turbomeck
POSTNORD_CONSIGNOR_STREET=
POSTNORD_CONSIGNOR_POSTAL_CODE=
POSTNORD_CONSIGNOR_CITY=
POSTNORD_CONSIGNOR_COUNTRY=SE
# POSTNORD_CONSIGNOR_PHONE=
# POSTNORD_CONSIGNOR_EMAIL=

# Product on agreement (default 52 — replace with code from your avtal)
# POSTNORD_EDI_BASIC_SERVICE_CODE=52
# Extra services, comma-separated or JSON array e.g. ["A3"]
# POSTNORD_EDI_ADDITIONAL_SERVICE_CODES=

# Party id type for avsändare (swagger example 160)
# POSTNORD_EDI_PARTY_ID_TYPE=160
# Issuer on parties (swagger example Z11)
# POSTNORD_EDI_ISSUER_CODE=Z11
# PartyIdType for service point (swagger example 17)
# POSTNORD_EDI_SERVICEPOINT_PARTY_ID_TYPE=17

# Test indicator on EDI Instruction (also auto-on when POSTNORD_USE_TEST_API=true)
# POSTNORD_EDI_TEST=true
# Application metadata (informational)
# POSTNORD_EDI_APPLICATION_ID=9999
# POSTNORD_EDI_APPLICATION_NAME=Turbomeck Admin
# POSTNORD_EDI_APPLICATION_VERSION=1.0
# POSTNORD_EDI_LANGUAGE=SV

# -----------------------------------------------------------------------------
# SMTP (magic-link login + transactional mail)
# -----------------------------------------------------------------------------
# Mail config is normally stored in `app_settings.mail` (admin Settings UI). These env
# vars are the bootstrap fallback used before/while that row is empty (e.g. first login).
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false              # true for SMTPS on port 465
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM=noreply@example.com
#
# Shared SMTP (Inleed/Loopia/One.com): the connection host is your vanity name (e.g.
# smtp.turbomeck.se) but the TLS cert is issued to the underlying physical server
# (e.g. prime4.inleed.net). Set this to the cert's hostname — the TCP connection still
# goes to SMTP_HOST, only TLS verification uses this name. No security loss.
# SMTP_TLS_SERVERNAME=prime4.inleed.net
#
# Last resort (skip cert verification entirely — only if you can't get the right hostname):
# SMTP_REJECT_UNAUTHORIZED=false
