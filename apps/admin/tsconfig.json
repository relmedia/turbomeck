{
  "extends": "@repo/typescript-config/nextjs.json",
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"],
      "@repo/ui/components/*": ["../../packages/ui/src/components/ui/*"],
      "@repo/ui/hooks/*": ["../../packages/ui/src/hooks/*"],
      "@repo/ui/lib/utils": ["../../packages/ui/src/lib/utils"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": [
    "node_modules",
    "src/lib/__verify-ai-generation.ts",
    "src/lib/__upload-email-logo.ts",
    "src/lib/__verify-asset-mirror.ts",
    "src/lib/__verify-suggest-seo.ts",
    "src/lib/__verify-catalogue-seo.ts",
    "src/lib/__verify-media-library.ts",
    "src/lib/__verify-media-delete.ts"
  ]
}
