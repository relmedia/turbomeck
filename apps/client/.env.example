# Copy to `.env` or `.env.local`. Do not commit real secrets.
#
# PostNord: https://developer.postnord.com · sandbox overview: https://postnord-test.3scale.net/

# -----------------------------------------------------------------------------
# PostNord — sandbox / local testing
# -----------------------------------------------------------------------------
# Uncomment when using a sandbox API key: REST (service points, track, …) goes to atapi2.postnord.com.
# POSTNORD_USE_TEST_API=true

POSTNORD_API_KEY=

# -----------------------------------------------------------------------------
# PostNord — Shipping Module (checkout: create-session, complete-session)
# Server: /api/postnord/shipping/* · browser widget: NEXT_PUBLIC_* script base.
# Use the Shipping Module credentials PostNord gives you (test vs prod). The [API_URL] in their
# docs may still be https://devportal.postnord.com/pn-shipping-module/v1 — if they provide another
# base for sandbox, set both URL lines below to that exact value.
# -----------------------------------------------------------------------------
POSTNORD_SHIPPING_API_URL=https://devportal.postnord.com/pn-shipping-module/v1
POSTNORD_SHIPPING_API_KEY=

# Checkout site code from PostNord (sandbox vs production site registration)
POSTNORD_SITE_CODE=acmeSE

NEXT_PUBLIC_POSTNORD_SHIPPING_MODULE_URL=https://devportal.postnord.com/pn-shipping-module/v1

# Production: set POSTNORD_USE_TEST_API=false (or remove it) and use production keys + api2.postnord.com hosts.
# Optional: only when NOT using POSTNORD_USE_TEST_API — custom REST gateway hostname (no https://)
# POSTNORD_API_HOST=api2.postnord.com

# Optional: if Track API v5 returns 404 for some ids, try v2
# POSTNORD_TRACK_SHIPMENT_VERSION=v2

# -----------------------------------------------------------------------------
# Auth (storefront public URL — magic links, sessions)
# -----------------------------------------------------------------------------
# AUTH_URL=http://localhost:3000
# NEXTAUTH_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Backend services
# -----------------------------------------------------------------------------
PRODUCT_SERVICE_URL=http://localhost:8000
PAYMENT_SERVICE_URL=http://localhost:8002
# Stripe publishable/secret keys live in apps/payment-service/.env (not here).
# Chrome “third-party cookies” for js.stripe.com are normal for embedded Payment Element (fraud prevention).
# If you see apps.rokt.com cookies, check Stripe Dashboard → Settings → Apps / partner integrations.
NEXT_PUBLIC_PRODUCT_API_URL=http://localhost:8000

# Shared secret for authenticated calls from this app into product-service
INTERNAL_PRODUCT_API_SECRET=

# -----------------------------------------------------------------------------
# Assets / R2
# -----------------------------------------------------------------------------
NEXT_PUBLIC_R2_PUBLIC_URL=
NEXT_PUBLIC_UPLOADS_BASE=http://localhost:3001

# Server-side R2 (if this app uploads avatars, etc.)
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=turbomeck
# R2_PUBLIC_URL=

# Password reset “app” base (defaults differ in code if unset)
# NEXT_PUBLIC_APP_URL=http://localhost:3000
