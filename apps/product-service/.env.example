# Database
DATABASE_URL=postgresql://...

# Same value required on storefront + admin apps (INTERNAL_PRODUCT_API_SECRET in their .env)
INTERNAL_PRODUCT_API_SECRET=generate-a-long-random-string

# Cloudflare R2 (for product images)
# Get these from: Cloudflare Dashboard → R2 → Manage R2 API Tokens
R2_ACCOUNT_ID=your_account_id
R2_ACCESS_KEY_ID=your_access_key_id
R2_SECRET_ACCESS_KEY=your_secret_access_key
R2_BUCKET_NAME=turbomeck
# Public URL for the bucket – enable "Allow public access" in R2 bucket settings to get e.g. https://pub-xxx.r2.dev
# Or use a custom domain like https://images.yoursite.com
R2_PUBLIC_URL=https://pub-xxxxxxxx.r2.dev
