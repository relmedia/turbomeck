{
  "name": "tmeck",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:push": "pnpm --filter @repo/database db:push",
    "db:generate": "pnpm --filter @repo/database db:generate",
    "db:migrate": "pnpm --filter @repo/database db:migrate",
    "db:studio": "pnpm --filter @repo/database db:studio",
    "db:seed": "pnpm --filter @repo/database db:seed",
    "db:export": "pnpm --filter @repo/database db:export",
    "db:import": "pnpm --filter @repo/database db:import",
    "db:check": "pnpm --filter @repo/database db:check",
    "db:products": "pnpm --filter @repo/database db:products",
    "debug:products": "node scripts/debug/product-pipeline.mjs",
    "delete-r2-images": "pnpm --filter product-service delete-r2-images",
    "migrate-images": "pnpm --filter product-service migrate-images"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.2.5",
    "turbo": "^2.5.8",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18"
  },
  "pnpm": {
    "overrides": {
      "react": "19.1.4",
      "react-dom": "19.1.4",
      "sharp": "0.32.6",
      "next": ">=16.2.6",
      "jsdom": "^28.1.0",
      "undici": ">=7.24.0",
      "dompurify": ">=3.4.0",
      "postcss": ">=8.5.10",
      "path-to-regexp": ">=8.4.0",
      "fast-uri": ">=3.1.2",
      "fast-xml-parser": ">=5.5.7",
      "qs": ">=6.14.1",
      "body-parser": ">=2.2.1",
      "ajv": ">=8.18.0",
      "@hono/node-server": ">=1.19.13",
      "@imgly/background-removal-node>zod": ">=3.22.3"
    }
  }
}
