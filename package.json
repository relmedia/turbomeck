{
  "name": "tmeck",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:push": "pnpm --filter @repo/database db:push",
    "db:generate": "pnpm --filter @repo/database db:generate",
    "db:migrate": "pnpm --filter @repo/database db:migrate",
    "db:studio": "pnpm --filter @repo/database db:studio",
    "remove-bg": "pnpm --filter product-service remove-bg",
    "regenerate-images": "pnpm --filter product-service remove-bg"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.2.5",
    "turbo": "^2.5.8",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18"
  },
  "pnpm": {
    "overrides": {
      "react": "19.1.4",
      "react-dom": "19.1.4"
    }
  }
}
