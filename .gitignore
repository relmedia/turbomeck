# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Dependencies
node_modules
.pnp
.pnp.js

# Local env files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Testing
coverage

# Turbo
.turbo

# Vercel
.vercel

# Build Outputs
.next/
out/
build
dist


# Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
debug-*.log

# Misc
.DS_Store
*.pem

# SECURITY (audit L6): we intentionally do NOT wildcard `*.example`. .env.example
# files are documentation of which environment variables exist and MUST be
# checked in. The earlier `*.example` line silently hid them, so contributors
# had to ask out-of-band what to set.
#
# If you ever need to ignore a specific local-only example file, add an
# explicit path here (e.g. `secret-stuff.local.example`).

# Audit recovery scratch files — these get created when we re-extract the
# audit report from agent transcripts. Always machine-generated, never useful
# to track.
.audit.md
.audit-*.txt

# Next.js generated type shim. NOT safe to track: Next 16 writes a different
# import line for dev (`.next/dev/types/routes.d.ts`) than for build
# (`.next/types/routes.d.ts`), so a dev machine and a build server overwrite
# each other's copy and every `git pull` on the deploy host aborts with
# "local changes would be overwritten". Regenerated by both `next dev` and
# `next build`, so there is nothing to preserve.
next-env.d.ts
