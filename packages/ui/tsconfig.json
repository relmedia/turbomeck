{
  "extends": "@repo/typescript-config/react-library.json",
  "compilerOptions": {
    "noEmit": true,
    "jsx": "preserve",
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "ES2017",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "noUncheckedIndexedAccess": false
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules"]
}
