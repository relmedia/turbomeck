{
  "name": "@repo/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.ts"
  },
  "scripts": {
    "db:generate": "drizzle-kit generate --config=drizzle.config.cjs",
    "db:migrate": "drizzle-kit migrate --config=drizzle.config.cjs",
    "db:push": "drizzle-kit push --config=drizzle.config.cjs",
    "db:studio": "drizzle-kit studio --config=drizzle.config.cjs",
    "db:seed": "tsx src/seed.ts",
    "db:export": "tsx scripts/export-db.ts",
    "db:import": "tsx scripts/import-db.ts",
    "db:check": "tsx src/check.ts",
    "db:migrate-categories": "tsx scripts/migrate-to-product-categories.ts",
    "db:set-admin": "tsx scripts/set-admin-role.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.39.0",
    "postgres": "^3.4.5"
  },
  "devDependencies": {
    "drizzle-kit": "^0.30.0",
    "tsx": "^4.7.1",
    "typescript": "^5.9.2"
  }
}

